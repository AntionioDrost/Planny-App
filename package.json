{
  "name": "shiftplanner-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop roosterplanner voor het genereren van diensten.",
  "author": "Local project",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "ShiftPlanner Pro",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "dist:win": "npm run build && node electron/package.cjs",
    "preview": "vite preview",
    "clean": "node -e \"['dist','release','.desktop-build'].forEach((dir) => { try { require('fs').rmSync(dir, { recursive: true, force: true }); } catch {} })\"",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.0"
  }
}
